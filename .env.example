# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, "Session pooler" or direct).
# Must end with ?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Random long string used to sign backend session JWTs (not related to Google)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Your deployed frontend URL, for CORS. Use http://localhost:5500 (or similar) while developing locally.
FRONTEND_ORIGIN=https://your-frontend-url.com

# Euclidean distance threshold for face_recognition.compare_faces — lower = stricter match.
FACE_MATCH_TOLERANCE=0.5
